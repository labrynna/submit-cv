# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL from: https://app.supabase.com/project/<your-project>/settings/api
SUPABASE_URL=https://<your-project-ref>.supabase.co

# Service-role key (full DB access) — NEVER expose this to the browser.
# Found at: Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Used to generate 768-dim embeddings (text-embedding-004) for semantic CV search.
# Free tier: 1 500 requests/minute — no credit card required.
# Obtain at: https://aistudio.google.com/apikey
# Optional: if omitted, CVs are stored without embeddings (AI search disabled).
GEMINI_API_KEY=AIza...
