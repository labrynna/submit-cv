# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL from: https://app.supabase.com/project/<your-project>/settings/api
SUPABASE_URL=https://<your-project-ref>.supabase.co

# Service-role key (full DB access) — NEVER expose this to the browser.
# Found at: Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Used to generate 1536-dim embeddings for semantic CV search.
# Obtain at: https://platform.openai.com/api-keys
# Optional: if omitted, CVs are stored without embeddings (AI search disabled).
OPENAI_API_KEY=sk-...
