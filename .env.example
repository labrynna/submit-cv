# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL from: https://app.supabase.com/project/<your-project>/settings/api
SUPABASE_URL=https://<your-project-ref>.supabase.co

# Service-role key (full DB access) — NEVER expose this to the browser.
# Found at: Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Google Gemini (primary embedding provider) ────────────────────────────────
# Used to generate 768-dim embeddings (text-embedding-004) for semantic CV search.
# Free tier: 1 500 requests/minute — no credit card required.
# Obtain at: https://aistudio.google.com/apikey
# Optional: if omitted, the OpenRouter fallback is tried instead.
GEMINI_API_KEY=AIza...

# ── OpenRouter (fallback embedding provider) ──────────────────────────────────
# Used as a fallback when GEMINI_API_KEY is not set or Gemini fails.
# Provides access to openai/text-embedding-3-small with 768-dim output.
# Free tier available. Obtain at: https://openrouter.ai/keys
# Optional: if both GEMINI_API_KEY and OPENROUTER_API_KEY are omitted,
# CVs are stored without embeddings (AI search disabled).
OPENROUTER_API_KEY=sk-or-v1-...

# ── Signed URL expiry ─────────────────────────────────────────────────────────
# Lifetime in seconds for signed CV download URLs generated by GET /api/cv-url.
# Defaults to 300 (5 minutes) if not set.
# SIGNED_URL_EXPIRY_SECONDS=300
